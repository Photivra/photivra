{
  "name": "@photivra/engine",
  "version": "2.7.0",
  "private": false,
  "description": "Scientific TypeScript engine for camera optics, exposure, focus, motion, sensor sampling, diffraction, and digital imaging calculations.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/camera",
    "dist/capture",
    "dist/color",
    "dist/composition",
    "dist/core",
    "dist/equipment",
    "dist/facade",
    "dist/exposure",
    "dist/gpu",
    "dist/motion",
    "dist/optics",
    "dist/output",
    "dist/schema",
    "dist/sensor",
    "dist/simulation",
    "dist/stabilization",
    "dist/processing",
    "!dist/capture/browser-native-reference-*",
    "!dist/schema/camera.js",
    "!dist/schema/camera.js.map",
    "!dist/schema/scene.js",
    "!dist/schema/scene.js.map",
    "CHANGELOG.md",
    "README.md",
    "CITATION.cff",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "NODE_SUPPORT.md",
    "THIRD_PARTY.md",
    "llms.txt",
    "docs/USAGE.md",
    "docs/QUICK_START.md",
    "docs/AGENT_GUIDE.md",
    "docs/API_REFERENCE.md",
    "docs/api",
    "docs/examples"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Photivra/photivra.git"
  },
  "bugs": {
    "url": "https://github.com/photivra/photivra/issues"
  },
  "homepage": "https://github.com/photivra/photivra#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepush": "node scripts/prepush.mjs",
    "check:static": "eslint . && tsc --noEmit && npm run check:licenses && npm run check:license-headers && npm run check:identity && npm run check:browser-surface",
    "check": "npm run check:static && vitest run",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:check": "node scripts/check-package-surface.mjs",
    "coverage": "vitest run --coverage",
    "test:webgpu": "vitest run --config vitest.webgpu.config.ts",
    "bench:webgpu": "vitest run --config vitest.webgpu-timing.config.ts",
    "test:webgpu:hardware": "node scripts/run-webgpu-hardware.mjs test",
    "bench:webgpu:hardware": "node scripts/run-webgpu-hardware.mjs bench",
    "check:browser-surface": "node scripts/check-browser-surface.mjs",
    "check:licenses": "node scripts/check-license-policy.mjs",
    "check:license-headers": "node scripts/check-license-headers.mjs",
    "check:identity": "node scripts/check-project-identity.mjs",
    "bench:image-formation": "npm run build && npm run bench:image-formation:built",
    "bench:image-formation:built": "node --expose-gc scripts/benchmark-image-formation.mjs",
    "profile:native-reference": "node --expose-gc scripts/profile-native-reference-path.mjs",
    "assess:native-full-event": "node scripts/assess-browser-native-full-event.mjs",
    "qualify:native-reference-progressive": "node --expose-gc scripts/qualify-browser-native-progressive.mjs",
    "docs:check": "node scripts/check-release-docs.mjs",
    "release:consumer-check": "node scripts/check-release-consumer.mjs",
    "release:prepare": "node scripts/release-prepare.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "rolldown": "1.2.9"
  },
  "keywords": [
    "photography",
    "camera",
    "optics",
    "digital-imaging",
    "imaging-science",
    "depth-of-field",
    "exposure",
    "motion-blur",
    "diffraction",
    "image-sensor",
    "signal-to-noise",
    "scientific-computing",
    "typescript"
  ]
}
